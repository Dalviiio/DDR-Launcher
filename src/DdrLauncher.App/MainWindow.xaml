<Window x:Class="DdrLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dalviiio DDR Launcher" Width="1120" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Main}" FontSize="14"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side rail -->
        <Border Background="{StaticResource Brush.Sunken}">
            <DockPanel Margin="16,18,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
                    <TextBlock Text="DALVIIIO" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Brush.TextSubtle}" />
                    <TextBlock Text="DDR Launcher" FontSize="20" FontWeight="ExtraBold" />
                </StackPanel>

                <!-- Game folder -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGame}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Tertiary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Game folder" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding GameFolderText}" ToolTip="{Binding GameFolderText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,10" />
                        <Button Style="{StaticResource Button.Base}" Content="Change" Tag="{StaticResource Icon.FolderOpen}" MinHeight="34" Click="OnChooseGameFolder"
                                ToolTip="Pick the Dakar Desert Rally folder (the one that contains Dakar2Game)." />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Content="Mods" Tag="{StaticResource Icon.Puzzle}" IsChecked="True" GroupName="Nav" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                <Button Style="{StaticResource Button.Caption}" Tag="{StaticResource Icon.Minimize}" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Tag="{StaticResource Icon.Maximize}" Click="OnMaximize" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
                <Button Style="{StaticResource Button.CaptionClose}" Tag="{StaticResource Icon.Close}" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close" />
            </StackPanel>

            <!-- Header -->
            <Grid Grid.Row="1" Margin="36,0,36,20">
                <StackPanel>
                    <TextBlock Text="Mods" FontSize="28" FontWeight="ExtraBold" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Button.Primary}" Content="Add mods" Tag="{StaticResource Icon.Add}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        MinHeight="44" Click="OnAddMods" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                        ToolTip="Add .pak files or .zip, .rar, .7z archives. You can also drop them anywhere on this window." />
            </Grid>

            <!-- Game not found -->
            <Border Grid.Row="2" Margin="36,0,36,16" Padding="16,12" CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource Brush.WarningSoft}"
                    BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                    Visibility="{Binding HasGame, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Base}" Content="Choose folder" Tag="{StaticResource Icon.FolderOpen}" Click="OnChooseGameFolder" />
                    <Path Data="{StaticResource Icon.Warning}" Style="{StaticResource Icon}" Fill="{StaticResource Brush.Warning}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Dakar Desert Rally was not found. Choose its folder to switch mods on." />
                </DockPanel>
            </Border>

            <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="36,-8,36,0" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource Brush.Tertiary}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- Empty state: one big drop target -->
            <Border Grid.Row="3" Margin="36,0,36,32" CornerRadius="18" BorderThickness="2" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.BorderStrong}"
                    Visibility="{Binding HasMods, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource Brush.SecondarySoft}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource Icon.Archive}" Style="{StaticResource Icon}" Width="28" Height="28" Fill="{StaticResource Brush.Text}" />
                    </Border>
                    <TextBlock Text="Drop your mods here" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                               Text=".pak files, .zip, .rar or .7z archives, or a folder. They go into your library first; the game only sees the ones you switch on." />
                    <Button Style="{StaticResource Button.Primary}" Content="Browse files" Tag="{StaticResource Icon.Add}" HorizontalAlignment="Center" Margin="0,20,0,0"
                            MinHeight="44" Click="OnAddMods" />
                </StackPanel>
            </Border>

            <!-- Mod list -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="36,0,28,24"
                          Visibility="{Binding HasMods, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Mods}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="Badge" Width="44" Height="44" CornerRadius="12" Background="{StaticResource Brush.Sunken}" Margin="0,0,14,0">
                                        <Path Data="{StaticResource Icon.Archive}" Style="{StaticResource Icon}" Fill="{StaticResource Brush.TextMuted}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding FileList}">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Normal actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsConfirmingRemoval, Converter={StaticResource InverseBoolToVisibility}}">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" Content="{Binding StateText}" Margin="0,0,16,0"
                                                  IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Use {0} in the game'}"
                                                  ToolTip="Switch on to put this mod in the game. Switch off to take it out." />
                                        <Button Style="{StaticResource Button.IconDanger}" Tag="{StaticResource Icon.Delete}" Command="{Binding AskRemoveCommand}"
                                                ToolTip="Remove from the library" AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}" />
                                    </StackPanel>

                                    <!-- Inline confirmation instead of a dialog -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsConfirmingRemoval, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Remove this mod?" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                        <Button Style="{StaticResource Button.Base}" Content="Cancel" Command="{Binding CancelRemoveCommand}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource Button.Danger}" Content="Remove" Tag="{StaticResource Icon.Delete}" Command="{Binding RemoveCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource Brush.TertiarySoft}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConfirmingRemoval}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Message bar -->
            <Border Grid.Row="4" Margin="36,0,36,20" Padding="16,10" CornerRadius="{StaticResource Radius.Control}"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.TertiarySoft}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Tag="{StaticResource Icon.Close}" Width="32" Height="32" MinHeight="32"
                            Command="{Binding DismissMessageCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message" />
                    <Path DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                <Setter Property="Data" Value="{StaticResource Icon.Info}" />
                                <Setter Property="Fill" Value="{StaticResource Brush.Tertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Icon.Error}" />
                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Drop overlay -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#D9101548" IsHitTestVisible="False">
            <Border Margin="28" CornerRadius="22" BorderThickness="3" BorderBrush="{StaticResource Brush.Secondary}" Background="#336728D0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.Add}" Style="{StaticResource Icon}" Width="44" Height="44" Fill="{StaticResource Brush.Text}" />
                    <TextBlock Text="Drop to add to your library" FontSize="22" FontWeight="ExtraBold" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
