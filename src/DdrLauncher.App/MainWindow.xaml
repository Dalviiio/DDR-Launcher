<Window x:Class="DdrLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DdrLauncher.App.Controls"
        Title="Dalviiio DDR Launcher" Height="820" Width="1340" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        WindowStyle="None" Background="{StaticResource Brush.Background}" ResizeMode="CanResize"
        FontFamily="{StaticResource Font.Main}" FontSize="14" Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True" Icon="Assets/DalviiioDDRLauncher.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Layout: a dark shell (side rail, caption strip, game bar) around one rounded content panel. -->
    <Border x:Name="Root" Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Side rail ===== -->
            <DockPanel Grid.RowSpan="2" Margin="18,18,14,14">
                <Image DockPanel.Dock="Top" Source="Assets/logo-ddr.png" Width="132" HorizontalAlignment="Center" Margin="0,8,0,26"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Profile in use, at the bottom of the rail: Default is the game as it ships -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="12,10,12,8" DataContext="{Binding Database}">
                    <StackPanel>
                        <TextBlock Text="PROFILE" Style="{StaticResource Text.Label}" Margin="2,0,0,6" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Profile"
                                  ToolTip="The lineup you are editing. Apply puts it in the game." />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="New" c:Ui.Icon="{StaticResource Icon.Add}" Click="OnNewProfile" Margin="0,0,2,0"
                                    ToolTip="A new profile, copied from this one" />
                            <Button Style="{StaticResource GhostButton}" Content="Rename" Click="OnRenameProfile" Margin="0,0,2,0"
                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Delete}" Click="OnDeleteProfile" ToolTip="Delete this profile"
                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="ModsNav" Style="{StaticResource NavItem}" Content="Mods" c:Ui.Icon="{StaticResource Icon.Puzzle}" Tag="{Binding Mods.Count}" IsChecked="True" GroupName="Nav" />
                    <RadioButton x:Name="PaddockNav" Style="{StaticResource NavItem}" Content="Paddock" c:Ui.Icon="{StaticResource Icon.Team}" GroupName="Nav" />
                </StackPanel>
            </DockPanel>

            <!-- ===== Caption strip ===== -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,10,0">
                <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource Brush.TextSubtle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <RadioButton x:Name="SettingsNav" Style="{StaticResource IconToggle}" c:Ui.Icon="{StaticResource Icon.Settings}" GroupName="Nav" Margin="0,0,8,0"
                             WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Settings" AutomationProperties.Name="Settings" />
                <Button Style="{StaticResource WindowButton}" c:Ui.Icon="{StaticResource Icon.Minimize}" Click="OnMinimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" c:Ui.Icon="{StaticResource Icon.Maximize}" Click="OnMaximize"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                <Button Style="{StaticResource CloseWindowButton}" c:Ui.Icon="{StaticResource Icon.Close}" Click="OnClose"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
            </StackPanel>

            <!-- ===== Content panel ===== -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Brush.Surface}" CornerRadius="22,0,0,0"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,1,0,1" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ===== Paddock: line-up, garage and drivers, under one edition and class filter ===== -->
                    <Grid Grid.RowSpan="2" DataContext="{Binding Database}"
                          Visibility="{Binding IsChecked, ElementName=PaddockNav, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tabs, search and the Add button of the open tab -->
                        <DockPanel Margin="32,24,24,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding AddText}" c:Ui.Icon="{StaticResource Icon.Add}"
                                    Click="OnAdd" Margin="10,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}"
                                    Visibility="{Binding IsGarage, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Grid DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
                                <TextBox x:Name="PaddockSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,10,8" AutomationProperties.Name="Search" />
                                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource SmallIcon}" Fill="{StaticResource Brush.TextSubtle}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                                <TextBlock Text="Search" Foreground="{StaticResource Brush.TextSubtle}" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PaddockSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource PaddockTab}" Content="Lineup" CommandParameter="Lineup" Tag="{Binding CrewCount}" GroupName="PaddockTab" IsChecked="True" Checked="OnPaddockTab" />
                                <RadioButton Style="{StaticResource PaddockTab}" Content="Garage" CommandParameter="Garage" Tag="{Binding VehicleCount}" GroupName="PaddockTab" Checked="OnPaddockTab" />
                                <RadioButton Style="{StaticResource PaddockTab}" Content="Drivers" CommandParameter="Drivers" Tag="{Binding PilotCount}" GroupName="PaddockTab" Checked="OnPaddockTab" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Edition plates, then class (or role on the Drivers tab) -->
                        <DockPanel Grid.Row="1" Margin="32,18,24,16">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}"
                                    Visibility="{Binding IsDrivers, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="All" CommandParameter="All" GroupName="Class" IsChecked="True" Checked="OnClass" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Cars" CommandParameter="Car" GroupName="Class" Checked="OnClass" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Trucks" CommandParameter="Truck" GroupName="Class" Checked="OnClass" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Bikes" CommandParameter="Bike" GroupName="Class" Checked="OnClass" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Quads" CommandParameter="Quad" GroupName="Class" Checked="OnClass" />
                                    <RadioButton Style="{StaticResource Segment}" Content="SSV" CommandParameter="Ssv" GroupName="Class" Checked="OnClass" />
                                </StackPanel>
                            </Border>
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBar}"
                                    Visibility="{Binding IsDrivers, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="All" CommandParameter="All" GroupName="Role" IsChecked="True" Checked="OnPilotRole" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Drivers" CommandParameter="Driver" GroupName="Role" Checked="OnPilotRole" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Co-drivers" CommandParameter="CoDriver" GroupName="Role" Checked="OnPilotRole" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Editions}" Focusable="False" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource Plate}" IsChecked="{Binding IsDefault, Mode=OneTime}" CommandParameter="{Binding Key}" GroupName="Edition" Checked="OnEdition"
                                                     AutomationProperties.Name="{Binding Key}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- ===== Lineup tab ===== -->
                        <Grid Grid.Row="2" Visibility="{Binding IsLineup, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="32,0,0,0">
                                <ListBox ItemsSource="{Binding CrewsView}" SelectedItem="{Binding SelectedCrew}" Style="{StaticResource CardList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="222">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="136" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <!-- Showroom: the team's vehicle, its plate and edition -->
                                                <Border CornerRadius="15,15,0,0" Background="{StaticResource Brush.Showroom}" />
                                                <Ellipse Height="26" Margin="40,0,40,10" VerticalAlignment="Bottom" Opacity="0.55">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#7A3BE3" Offset="0" />
                                                            <GradientStop Color="#007A3BE3" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Path Data="{StaticResource Icon.Car}" Fill="{StaticResource Brush.BorderStrong}" Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.LayoutTransform>
                                                        <ScaleTransform ScaleX="1.8" ScaleY="1.8" />
                                                    </Path.LayoutTransform>
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Picture}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Border CornerRadius="10" Margin="10,30,10,8" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Picture}" Stretch="Uniform" />
                                                    </Border.Background>
                                                </Border>
                                                <Border Background="{StaticResource Brush.Text}" CornerRadius="6" Padding="8,1" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Team.Number}" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Background}" />
                                                </Border>
                                                <TextBlock Text="{Binding EditionText}" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Info}" Margin="0,16,14,0"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <Border x:Name="Edited" Background="{StaticResource Brush.Accent}" CornerRadius="5" Padding="7,2" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Visibility="Collapsed">
                                                    <TextBlock x:Name="EditedText" Text="EDITED" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Brush.OnAccent}" />
                                                </Border>

                                                <StackPanel Grid.Row="1" Margin="16,10,16,0">
                                                    <TextBlock Text="{Binding Team.Name}" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Brush.TextSubtle}" TextTrimming="CharacterEllipsis" />
                                                    <DockPanel Margin="0,3,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Vehicle.Brand}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Bottom" Margin="8,0,0,1" />
                                                        <TextBlock Text="{Binding VehicleName}" FontSize="16" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <Path Data="{StaticResource Icon.Person}" Style="{StaticResource SmallIcon}" Fill="{StaticResource Brush.TextSubtle}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding CrewText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                    <Setter TargetName="Edited" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                    <Setter TargetName="Edited" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Edited" Property="Background" Value="{StaticResource Brush.Info}" />
                                                    <Setter TargetName="EditedText" Property="Text" Value="NEW" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Crew drawer: pick the vehicle, driver and co-driver -->
                            <Border Grid.Column="1" Style="{StaticResource Drawer}"
                                    Visibility="{Binding HasCrew, Converter={StaticResource BoolToVisibility}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                                <DockPanel DataContext="{Binding SelectedCrew}">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Close}" Click="OnCloseCrew"
                                                VerticalAlignment="Top" Margin="0,-6,-8,0" ToolTip="Close" />
                                        <Border Background="{StaticResource Brush.Text}" CornerRadius="6" Padding="8,1" VerticalAlignment="Top" Margin="0,2,10,0">
                                            <TextBlock Text="{Binding Team.Number}" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Background}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding EditionText}" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Info}" />
                                            <TextBlock Text="{Binding Team.Name}" FontSize="18" FontWeight="ExtraBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid DockPanel.Dock="Top" Height="130" Margin="0,0,0,12">
                                        <Border CornerRadius="14" Background="{StaticResource Brush.Showroom}" />
                                        <Border CornerRadius="14" Margin="8" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Picture}" Stretch="Uniform" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <!-- The game's photo of this crew, when there is one -->
                                    <Border DockPanel.Dock="Top" Height="96" CornerRadius="14" Margin="0,0,0,16">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding CrewPhoto}" Stretch="UniformToFill" AlignmentY="Top" />
                                        </Border.Background>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CrewPhoto}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBlock Text="VEHICLE" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding VehicleOptions}" SelectedItem="{Binding Vehicle}" DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName" AutomationProperties.Name="Vehicle" IsEnabled="{Binding CanEdit}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBlock Text="SKIN" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding SkinOptions}" SelectedItem="{Binding Skin}" ItemTemplate="{StaticResource SkinItem}" TextSearch.TextPath="SkinName"
                                                  AutomationProperties.Name="Skin" IsEnabled="{Binding CanEdit}" ToolTip="The liveries of this vehicle in this edition" />
                                        <Button Content="Livery" c:Ui.Icon="{StaticResource Icon.Car}" Click="OnLivery" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                ToolTip="Open the car in 3D to export this livery and import your painted version" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <TextBlock Text="DRIVER" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding PilotOptions}" SelectedItem="{Binding Driver}" DisplayMemberPath="Name" TextSearch.TextPath="Name" AutomationProperties.Name="Driver" IsEnabled="{Binding CanEdit}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding HasCoDriver, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="CO-DRIVER" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding PilotOptions}" SelectedItem="{Binding CoDriver}" DisplayMemberPath="Name" TextSearch.TextPath="Name" AutomationProperties.Name="Co-Driver" IsEnabled="{Binding CanEdit}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Content="Reset team" c:Ui.Icon="{StaticResource Icon.Undo}" Click="OnResetCrew" IsEnabled="{Binding IsEdited}"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Top" Style="{StaticResource DangerButton}" Content="Delete team" c:Ui.Icon="{StaticResource Icon.Delete}" Click="OnDeleteTeam"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" Margin="0,12,0,0">
                                        <Run Text="Game crew:" /> <Run Text="{Binding OriginalText, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- ===== Garage tab: one vehicle in the showroom, the others below ===== -->
                        <Grid Grid.Row="2" Margin="32,0,0,0" Visibility="{Binding IsGarage, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Height="262" CornerRadius="20" Background="{StaticResource Brush.Showroom}" Margin="0,0,24,14"
                                    Visibility="{Binding HasVehicle, Converter={StaticResource BoolToVisibility}}">
                                <Grid DataContext="{Binding SelectedVehicle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Height="40" Margin="50,0,50,24" VerticalAlignment="Bottom" Opacity="0.6">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#7A3BE3" Offset="0" />
                                                <GradientStop Color="#007A3BE3" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Border CornerRadius="14" Margin="26,22,10,30" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Picture}" Stretch="Uniform" />
                                        </Border.Background>
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Delete" c:Ui.Icon="{StaticResource Icon.Delete}" Click="OnDeleteVehicle"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" ToolTip="Delete this added vehicle"
                                            Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Grid.Column="1" Margin="10,26,30,22" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Brush.AccentHover}">
                                            <Run Text="{Binding Brand, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ClassText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="28" FontWeight="ExtraBold" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Id, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Font.Mono}" FontSize="11" ToolTip="Row name" />
                                        <UniformGrid Columns="3" Margin="0,14,0,14">
                                            <StackPanel>
                                                <TextBlock Text="PRICE" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding PriceText}" FontWeight="ExtraBold" FontSize="16" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="MAX SPEED" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding MaxSpeedText}" FontWeight="ExtraBold" FontSize="16" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="TEAMS" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding Teams.Count}" FontWeight="ExtraBold" FontSize="16" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatRow}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,14,0" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding VehiclesView}" SelectedItem="{Binding SelectedVehicle}" Style="{StaticResource CardList}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <c:VirtualizingTilePanel ItemMinWidth="176" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="124">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="76" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="15,15,0,0" Background="{StaticResource Brush.Showroom}" />
                                            <Border CornerRadius="10" Margin="8,8,8,4" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Picture}" Stretch="Uniform" />
                                                </Border.Background>
                                            </Border>
                                            <Border Background="{StaticResource Brush.Info}" CornerRadius="5" Padding="6,1" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="NEW" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Brush.OnAccent}" />
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="12,6,12,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding Brand}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- ===== Drivers tab ===== -->
                        <Grid Grid.Row="2" Visibility="{Binding IsDrivers, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox Margin="32,0,0,0" ItemsSource="{Binding PilotsView}" SelectedItem="{Binding SelectedPilot}" Style="{StaticResource CardList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Height="78" Margin="14,0,16,0">
                                            <Grid DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,14,0">
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#6728D0" Offset="0" />
                                                            <GradientStop Color="#2C77DA" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Path Data="{StaticResource Icon.Person}" Stretch="Uniform" Width="20" Height="20" Fill="{StaticResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <!-- The driver's face from the game's crew photo, over the icon when there is one -->
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Photo}" Viewbox="{Binding PhotoViewbox}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <Border DockPanel.Dock="Right" Background="{StaticResource Brush.Info}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="NEW" FontSize="9" FontWeight="ExtraBold" Foreground="{StaticResource Brush.OnAccent}" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Teams.Count}" FontWeight="ExtraBold" FontSize="15" Foreground="{StaticResource Brush.TextSubtle}" VerticalAlignment="Center"
                                                       ToolTip="{Binding TeamsText}" Margin="8,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="1" Style="{StaticResource Drawer}"
                                    Visibility="{Binding HasPilot, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel DataContext="{Binding SelectedPilot}">
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Close}" Click="OnClosePilot"
                                                VerticalAlignment="Top" Margin="0,-6,-8,0" ToolTip="Close" />
                                        <Grid DockPanel.Dock="Left" Width="58" Height="58" Margin="0,0,14,0">
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#6728D0" Offset="0" />
                                                        <GradientStop Color="#2C77DA" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Path Data="{StaticResource Icon.Person}" Stretch="Uniform" Width="26" Height="26" Fill="{StaticResource Brush.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- The driver's face from the game's crew photo, over the icon when there is one -->
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Photo}" Viewbox="{Binding PhotoViewbox}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Country}" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Brush.AccentHover}" />
                                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="ExtraBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,18,0,16">
                                        <TextBlock Text="TEAMS" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="{Binding Teams.Count}" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBox DockPanel.Dock="Bottom" Text="{Binding Id, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                             Margin="0,10,0,0" ToolTip="Row name" />
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource DangerButton}" Content="Delete driver" c:Ui.Icon="{StaticResource Icon.Delete}" Click="OnDeletePilot"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}" />

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Teams}" ItemTemplate="{StaticResource TeamCard}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Apply bar: what is on screen versus what is in the game -->
                        <Border Grid.Row="3" Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="16,10" Margin="32,8,24,18"
                                Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource DangerButton}" Content="Original game" c:Ui.Icon="{StaticResource Icon.Delete}" Click="OnResetEverything" Margin="0,0,6,0"
                                            ToolTip="Remove the launcher's pak from the game now and switch to Default. Your profiles stay."
                                            Visibility="{Binding HasEdits, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Apply" c:Ui.Icon="{StaticResource Icon.Checkmark}" Click="OnApplyLineup" Margin="0"
                                            IsEnabled="{Binding CanApply}" />
                                </StackPanel>
                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Idle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEdits}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding PendingText, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="{Binding ChangesText, Mode=OneWay}" Foreground="{StaticResource Brush.TextMuted}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <!-- Loading or error, over any tab -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Reading the game..." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Error}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="Locate" c:Ui.Icon="{StaticResource Icon.FolderOpen}" Click="OnLocateOodle" Margin="0,0,8,0"
                                            Visibility="{Binding NeedsOodle, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Retry" c:Ui.Icon="{StaticResource Icon.Sync}" Click="OnReloadDatabase" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Settings page -->
                    <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsChecked, ElementName=SettingsNav, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="32,28,32,24" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontSize="30" FontWeight="ExtraBold" Margin="0,0,0,20" />

                        <Border Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Change" c:Ui.Icon="{StaticResource Icon.FolderOpen}" Click="OnChooseGameFolder" Margin="12,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Game folder" FontWeight="Bold" />
                                    <TextBlock Text="{Binding GameFolderText}" Style="{StaticResource Text.Hint}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open" c:Ui.Icon="{StaticResource Icon.Folder}" Click="OnOpenDataFolder" Margin="12,0,0,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Launcher data" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DataFolder, Mode=OneTime}" Style="{StaticResource Text.Hint}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Text="Version" FontWeight="Bold" />
                            </DockPanel>
                        </Border>

                        <!-- File check -->
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="14" Padding="16,14" DataContext="{Binding Database}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Check files" c:Ui.Icon="{StaticResource Icon.Search}"
                                            Click="OnCheckFiles" Margin="12,0,0,0" IsEnabled="{Binding CanCheck}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Files" FontWeight="Bold" />
                                        <TextBlock Text="Looks at the game paks, your mods and the launcher's pak without changing them." Style="{StaticResource Text.Hint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding CheckResults}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,8,0,0">
                                                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="2,6,10,0" VerticalAlignment="Top" Fill="{StaticResource Brush.Info}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Problem">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Danger}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Hero: the game's own artwork fading into the page -->
                    <Grid Height="178" Visibility="{Binding IsChecked, ElementName=ModsNav, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="22,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2A1366" Offset="0" />
                                    <GradientStop Color="#0F2D63" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="22,0,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" AlignmentY="Center" Opacity="0.55" />
                            </Border.Background>
                        </Border>
                        <!-- Left shade for the title, bottom fade into the page -->
                        <Border CornerRadius="22,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F00A0D26" Offset="0" />
                                    <GradientStop Color="#880A0D26" Offset="0.55" />
                                    <GradientStop Color="#330A0D26" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#000A0D26" Offset="0.45" />
                                    <GradientStop Color="#FF0A0D26" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <DockPanel Margin="32,28,28,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Import folder" c:Ui.Icon="{StaticResource Icon.FolderAdd}" Click="OnImportFolder" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Import mods" c:Ui.Icon="{StaticResource Icon.Add}" Click="OnImportFiles" Margin="0"
                                        ToolTip=".pak, .zip, .rar, .7z" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="MOD LIBRARY" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Brush.AccentHover}" />
                                <TextBlock Text="Your stages" FontSize="30" FontWeight="ExtraBold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="32,4,0,0" Visibility="{Binding IsChecked, ElementName=ModsNav, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DockPanel>
                            <!-- Filters and quick actions -->
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,24,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.FolderOpen}" Click="OnOpenModsFolder"
                                        IsEnabled="{Binding HasGame}" ToolTip="Open ~mods" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Chip}" Content="All" Tag="{Binding Mods.Count}" GroupName="Filter" IsChecked="True" Checked="OnFilter" />
                                    <RadioButton Style="{StaticResource Chip}" Content="On" Tag="{Binding OnCount}" GroupName="Filter" Checked="OnFilter" />
                                    <RadioButton Style="{StaticResource Chip}" Content="Off" Tag="{Binding OffCount}" GroupName="Filter" Checked="OnFilter" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Drop strip, always under the grid -->
                            <Grid DockPanel.Dock="Bottom" Height="54" Margin="0,2,24,18">
                                <Rectangle RadiusX="14" RadiusY="14" Stroke="{StaticResource Brush.BorderStrong}" StrokeThickness="1.5" StrokeDashArray="5 4" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Archive}" Style="{StaticResource SmallIcon}" Fill="{StaticResource Brush.TextSubtle}" Margin="0,0,10,0" />
                                    <TextBlock Text="Drop mods here" Foreground="{StaticResource Brush.TextSubtle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <ListBox x:Name="StageList" ItemsSource="{Binding ModsView}" SelectedItem="{Binding SelectedMod}" Style="{StaticResource CardList}" ItemContainerStyle="{StaticResource ModCard}" Margin="0,8,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="132">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Accent stripe, lit while the mod is in the game -->
                                                <Border x:Name="Stripe" CornerRadius="16,0,0,16" Background="{StaticResource Brush.BorderStrong}" />
                                                <Grid Grid.Column="1" Margin="16,14,16,14">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat='Use {0} in the game'}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="STAGE" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom" Margin="0,0,6,3" />
                                                            <TextBlock x:Name="Stage" Text="{Binding StageText}" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Brush.TextSubtle}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.TextSubtle}" Margin="8,1,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FilesText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.TextSubtle}" Margin="8,1,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AddedText}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter TargetName="Stripe" Property="Background" Value="{StaticResource Brush.Accent}" />
                                                    <Setter TargetName="Stage" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                            Visibility="{Binding HasMods, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Border Width="72" Height="72" CornerRadius="22" Background="{StaticResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Puzzle}" Fill="{StaticResource Brush.Text}" Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.LayoutTransform>
                                                <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                                            </Path.LayoutTransform>
                                        </Path>
                                    </Border>
                                    <TextBlock Text="No stage yet" FontWeight="ExtraBold" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,4" />
                                    <TextBlock Text="Import or drop a mod" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>

                        <!-- Details drawer: opens on the selected card -->
                        <Border Grid.Column="1" Style="{StaticResource Drawer}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="{StaticResource Icon.Close}" Click="OnCloseDetails"
                                            VerticalAlignment="Top" Margin="0,-6,-8,0" ToolTip="Close" />
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Brush.AccentHover}">
                                            <Run Text="STAGE" /> <Run Text="{Binding SelectedMod.StageText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedMod.Name}" FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- In the game? -->
                                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Card}" CornerRadius="12" Padding="14,12" Margin="0,16,0,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding SelectedMod.IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Use this mod in the game" />
                                        <TextBlock Text="In game" FontWeight="Bold" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <!-- Key figures -->
                                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="SIZE" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="{Binding SelectedMod.SizeText}" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="FILES" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="{Binding SelectedMod.Files.Count}" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="ADDED" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="{Binding SelectedMod.AddedText}" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>

                                <Button DockPanel.Dock="Bottom" Style="{StaticResource DangerButton}" Content="Remove" c:Ui.Icon="{StaticResource Icon.Delete}"
                                        Click="OnRemoveMod" HorizontalAlignment="Stretch" Margin="0,12,0,0" />

                                <TextBlock DockPanel.Dock="Top" Text="FILES" Style="{StaticResource Text.Label}" Margin="0,20,0,8" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedMod.Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Brush.Card}" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size, Converter={StaticResource FileSize}}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <TextBox Text="{Binding Sha256, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource Font.Mono}"
                                                                 FontSize="10" TextWrapping="NoWrap" Margin="0,3,0,0"
                                                                 ToolTip="SHA-256" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Game bar ===== -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="14,12,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The game itself: click to pick its folder -->
                <Button Grid.ColumnSpan="2" Click="OnChooseGameFolder" Cursor="Hand" Margin="0,0,24,0" ToolTip="{Binding GameFolderText}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" Background="Transparent" CornerRadius="12" Padding="6">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource Brush.Card}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource Brush.Card}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="56" CornerRadius="6" Background="{StaticResource Brush.Card}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,40,56" RadiusX="6" RadiusY="6" />
                            </Border.Clip>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,14,0">
                            <TextBlock Text="Dakar Desert Rally" FontWeight="Bold" Foreground="{StaticResource Brush.Text}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                    <TextBlock Text="STEAM" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource Brush.Info}" />
                                </Border>
                                <TextBlock FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Set folder" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGame}" Value="True">
                                                    <Setter Property="Text" Value="Windows" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextSubtle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource SmallIcon}" Fill="{StaticResource Brush.TextSubtle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <DockPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Click="OnPlay" Margin="0" Padding="22,8" MinWidth="160" IsEnabled="{Binding HasGame}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Play}" Style="{StaticResource Icon}" Fill="{StaticResource Brush.OnAccent}" Margin="0,0,12,0" />
                        <TextBlock Text="Play" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
