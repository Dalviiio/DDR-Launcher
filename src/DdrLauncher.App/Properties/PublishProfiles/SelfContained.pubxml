<?xml version="1.0" encoding="utf-8"?>
<!--
  One DalviiioDDRLauncher.exe that runs on any 64-bit Windows 10/11 without installing .NET:
  dotnet publish src/DdrLauncher.App -p:PublishProfile=SelfContained
  The result goes to publish/ at the repository root (ignored by git).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
